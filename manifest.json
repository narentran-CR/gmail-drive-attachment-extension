
{
  "manifest_version": 3,
  "name": "Gmail Large Attachment to Drive",
  "version": "1.0.0",
  "description": "Uploads files larger than 2 MB to Google Drive and inserts viewer links into Gmail.",
  "permissions": [
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://mail.google.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_OAUTH_CLIENT_ID",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Add large files to Drive",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
